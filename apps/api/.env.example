# 1. RUNTIME
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# 2. DATABASE / NEON BRANCH
# Pooled URL — used by the app at runtime
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"
# Direct URL — used by Prisma migrations and Studio
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require"
# Neon's own name for the direct URL (injected by `neon-env run`); alternative to DIRECT_URL
# DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require"
NEON_BRANCH=dev
NEON_BRANCH_ID=br-xxxxxxxx
NEON_FUNCTION_HOST_SUFFIX=.compute.c-2.region.aws.neon.tech

# 3. STORAGE — AWS_* are the 4 bucket credentials Neon injects
AWS_ENDPOINT_URL_S3="https://br-xxxxxxxx.storage.c-2.region.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_xxxxxxxx"
AWS_SECRET_ACCESS_KEY="nsk_live_xxxxxxxxxxxxxxxx"
AWS_REGION="ap-southeast-1"
STORAGE_BUCKET_TRASH=trash
STORAGE_BUCKET_UPLOADS=uploads
FILE_SIZE=50000000

# 4. AUTH — generate with: openssl rand -base64 32
NEON_COOKIE_SECRET="replace-with-32-plus-random-characters"
NEON_AUTH_URL="https://ep-xxx.neonauth.region.aws.neon.tech/db/auth"
