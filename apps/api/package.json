{
	"name": "api",
	"type": "module",
	"private": true,
	"exports": {
		"./app": {
			"types": "./src/app.ts",
			"default": "./dist/app.js"
		}
	},
	"scripts": {
		"check-types": "prisma generate && tsc --noEmit",
		"dev": "prisma generate && tsx watch --tsconfig ./tsconfig.json src/",
		"build": "prisma generate && tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"test": "vitest run",
		"lint": "biome lint .",
		"format": "biome check --write .",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"db:validate": "prisma validate"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1170.0",
		"@aws-sdk/s3-request-presigner": "^3.1170.0",
		"@hono/node-server": "^2.1.3",
		"@hono/zod-validator": "^0.9.1",
		"@neon/auth": "~0.8.2",
		"@neon/config": "^1.14.2",
		"@neon/env": "^2.1.5",
		"@prisma/adapter-neon": "7.10.1",
		"@prisma/client": "7.10.1",
		"dotenv": "^18.0.10",
		"hono": "^4.13.16",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"neon": "^9.6.0",
		"pino-pretty": "^13.2.0",
		"prisma": "7.10.1",
		"tsx": "^4.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.1.2"
	}
}
