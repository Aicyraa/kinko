{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"services": {
		"web": {
			"root": "apps/web",
			"framework": "react-router"
		},
		"api": {
			"root": "apps/api",
			"framework": "hono"
		}
	},
	"rewrites": [
		{
			"source": "/api/(.*)",
			"destination": { "service": "api" }
		},
		{
			"source": "/(.*)",
			"destination": { "service": "web" }
		}
	]
}
