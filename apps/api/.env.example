# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Neon PostgreSQL
# Pooled connection (pgbouncer / Neon pooler) — used at runtime via @prisma/adapter-neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct connection — used by Prisma CLI for migrations and Prisma Studio
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"
