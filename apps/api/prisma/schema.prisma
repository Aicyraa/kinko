// Prisma schema — https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth identities live in neon_auth.user. This table stores only app-specific profile data.
model UserProfile {
  id                 String   @id @db.Uuid
  onboardingComplete Boolean  @default(false)
  defaultTenantId    String?  @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("user_profiles")
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members TenantMember[]
  folders Folder[]
  files   File[]

  @@map("tenants")
}

model TenantMember {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  userId    String     @db.Uuid
  role      TenantRole @default(MEMBER)
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_members")
}

model Folder {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  parentFolderId String?   @db.Uuid
  name           String
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, parentFolderId])
  @@map("folders")
}

model File {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  folderId     String?   @db.Uuid
  uploadedById String    @db.Uuid
  name         String
  objectKey    String    @unique
  mimeType     String
  sizeBytes    BigInt
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, folderId])
  @@map("files")
}
