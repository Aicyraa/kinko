# Runtime
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth
NEON_AUTH_URL=https://ep-example.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-32-char-minimum-base64url-secret

# Neon Object Storage (S3-compatible, scoped per environment)
AWS_ENDPOINT_URL_S3=https://br-example.storage.c-2.region.aws.neon.tech
AWS_ACCESS_KEY_ID=replace-with-scoped-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-scoped-secret-access-key
AWS_REGION=ap-southeast-1
STORAGE_BUCKET_UPLOADS=uploads
STORAGE_BUCKET_TRASH=trash

# Limits & Retention
FILE_SIZE=104857600
MAX_FILE_SIZE_BYTES=104857600
TRASH_RETENTION_DAYS=30

# Client & Monitoring
CLIENT_BASE_URL=https://kinko.vercel.app
ERROR_MONITORING_WEBHOOK_URL=
